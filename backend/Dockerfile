# =====================================================================
# 백엔드(Flask) 이미지 만드는 설계도
# =====================================================================

# 1) 파이썬 3.12 가 설치된 가벼운(slim) 리눅스 이미지에서 시작
FROM python:3.12-slim

# 2) 컨테이너 안에서 작업할 폴더를 /app 으로 정함 (없으면 자동 생성)
WORKDIR /app

# 3) 라이브러리 목록 파일만 먼저 복사해서 설치
#    → 코드만 바뀌었을 땐 이 단계를 캐시로 재사용해서 빌드가 빨라짐
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4) 나머지 소스 코드 복사
COPY . .

# 5) 이 컨테이너는 5000번 포트를 쓴다고 표시 (문서용 성격)
EXPOSE 5000

# 6) 실행 명령
#    gunicorn: 실제 서비스용 파이썬 웹 서버
#    -w 4     : 요청을 처리하는 작업자(worker) 4개 → 여러 사람이 동시에 써도 버팀
#    -b ...   : 모든 주소의 5000번 포트에서 요청 받기
#    app:app  : app.py 파일 안의 app 객체를 실행
CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:5000", "app:app"]
